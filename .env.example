# Canonical public origin. Use http://localhost:3000 in local .env.local.
NEXT_PUBLIC_SITE_URL=https://nis-hub-ura.vercel.app
# Enable only after Google is configured in Google Cloud and Supabase Auth.
GOOGLE_AUTH_ENABLED=false
# Enable only after the Apple Services ID, secret, and Supabase provider are configured.
APPLE_AUTH_ENABLED=false
# Public Supabase connection; never use a service-role/secret key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Legacy projects may use NEXT_PUBLIC_SUPABASE_ANON_KEY instead.

# Server-only support notifications. Configure locally/deployment secrets, never commit values.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
# Homework bot webhook: server-only, independent of support's destination chat.
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_HOMEWORK_AUTHOR_ID=
SUPABASE_SERVICE_ROLE_KEY=

# Server-only Gemini AI Study. Enable only for the approved adult audience.
AI_STUDY_ENABLED=true
GEMINI_API_KEY=
# Verified with this project on 2026-09-16; validate availability for your own key.
GEMINI_MODEL=gemini-3.6-flash
AI_STUDY_DAILY_LIMIT=10
AI_STUDY_MAX_PAGES=10
AI_STUDY_MAX_SOURCE_CHARS=30000
AI_STUDY_TIMEOUT_MS=25000

# v0.5.5 — server-only. Generate a unique 32-byte base64 key (see docs/v0.5.5-setup.md).
SMS_BASE_URL=https://sms.ura.nis.edu.kz
SMS_LOGIN_PATH=/Root/Account/Login?ReturnUrl=%2froot
SMS_SESSION_SECRET=
SMS_REQUEST_TIMEOUT_MS=15000
SMS_MAX_HTML_BYTES=2000000
SMS_DIARY_ENABLED=true

# v0.5.8 — anonymous public timetable; server-only, no EduPage credentials.
EDUPAGE_TIMETABLE_ENABLED=false
EDUPAGE_BASE_URL=https://nisuralsk.edupage.org
EDUPAGE_TIMETABLE_PATH=/timetable/
EDUPAGE_REQUEST_TIMEOUT_MS=15000
EDUPAGE_MAX_RESPONSE_BYTES=3000000
