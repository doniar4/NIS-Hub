# Copy to .env.local and fill in with your actual Supabase project values.
# Never commit .env.local. Never expose the service-role key to the browser.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Do NOT prefix with NEXT_PUBLIC_. Only used in server-side code
# (route handlers / server actions), never sent to the client.
SUPABASE_SERVICE_ROLE_KEY=
